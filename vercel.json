{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build && npm run build:vercel-api",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "api/_vercelBundle.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
