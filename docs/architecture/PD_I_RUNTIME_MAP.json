    "bom": "IsometrieModuleV48d.tsx -> materialRows / cumulativeData / totalWeight / totalVolume",
    "viewport": "IsometrieModuleV48d.tsx -> viewport: { zoom, panX, panY }",
    "selection": "IsometrieModuleV48d.tsx -> selectedNodeIds, selectedSegmentIds, selectedFitting, selectedDimensionId",
